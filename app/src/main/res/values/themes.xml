<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GptVoiceInput" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Dark, bare panel for the recognition UI. -->
    <style name="Theme.GptVoiceInput.Recognition" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/recognition_bg</item>
        <item name="android:statusBarColor">@color/recognition_bg</item>
        <item name="android:navigationBarColor">@color/recognition_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="SectionHeader" parent="TextAppearance.AppCompat.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="FieldLabel" parent="TextAppearance.AppCompat.Small">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
