<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup / device transfer: recordings and the API key must never
     leave the device through Android's backup transport. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
