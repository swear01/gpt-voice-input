<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
   
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_title"
            android:textColor="@color/settings_fg"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- OpenAI -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_openai" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/api_key_label" />

        <EditText
            android:id="@+id/api_key_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/api_key_hint"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/settings_field_fg"
            android:textColorHint="@color/settings_hint" />

        <TextView
            android:id="@+id/api_key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:text="@string/save" />

            <Button
                android:id="@+id/clear_api_key_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/clear_api_key"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Transcription -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_transcription" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/languages_label" />

        <EditText
            android:id="@+id/languages_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/languages_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/settings_field_fg"
            android:textColorHint="@color/settings_hint" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/context_label" />

        <EditText
            android:id="@+id/context_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/context_hint"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:textColor="@color/settings_field_fg"
            android:textColorHint="@color/settings_hint" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/keywords_label" />

        <EditText
            android:id="@+id/keywords_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/keywords_hint"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:textColor="@color/settings_field_fg"
            android:textColorHint="@color/settings_hint" />

        <!-- Recording -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_recording" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auto_stop_label" />

        <SeekBar
            android:id="@+id/auto_stop_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10" />

        <TextView
            android:id="@+id/auto_stop_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/settings_fg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Profile & backup -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_profile" />

        <LinearLayout
            android:id="@+id/import_row"
            style="@style/ActionRow"
            android:layout_marginTop="8dp">

            <TextView
                style="@style/ActionRowLabel"
                android:layout_weight="1"
                android:text="@string/import_settings" />

            <ImageView
                style="@style/ActionRowChevron"
                android:contentDescription="@string/cd_chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/export_row"
            style="@style/ActionRow">

            <TextView
                style="@style/ActionRowLabel"
                android:layout_weight="1"
                android:text="@string/export_settings" />

            <ImageView
                style="@style/ActionRowChevron"
                android:contentDescription="@string/cd_chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/export_full_row"
            style="@style/ActionRow">

            <TextView
                style="@style/ActionRowLabel"
                android:layout_weight="1"
                android:text="@string/export_full_backup" />

            <ImageView
                style="@style/ActionRowChevron"
                android:contentDescription="@string/cd_chevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/reset_profile_row"
            style="@style/ActionRow">

            <TextView
                style="@style/ActionRowLabel"
                android:layout_weight="1"
                android:text="@string/reset_transcription_profile" />

            <ImageView
                style="@style/ActionRowChevron"
                android:contentDescription="@string/cd_chevron" />
        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/backup_excludes_api_key"
            android:textColor="@color/settings_fg_dim"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
