<?xml version="1.0" encoding="utf-8"?>
<!--
    Bottom-anchored keyboard-height panel. The activity window is translucent;
    this panel is the only opaque content, so the calling app stays visible
    above it. Tap the panel to submit; the gear opens Settings.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_background"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/gear_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/recognition_fg_dim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <ImageView
                android:id="@+id/mic_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_mic"
                android:src="@drawable/ic_mic"
                app:tint="@color/recognition_fg" />

            <ProgressBar
                android:id="@+id/processing_bar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminateTint="@color/recognition_fg"
                android:visibility="gone" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/recognition_fg"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/recognition_fg_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/error_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/cancel_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel"
                    android:textColor="@color/recognition_fg" />

                <Button
                    android:id="@+id/open_settings_error_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/open_settings"
                    android:textColor="@color/recognition_fg"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/retry_button"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/retry"
                    android:textColor="@color/recognition_fg" />
            </LinearLayout>

            <Button
                android:id="@+id/settings_action_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/open_settings"
                android:textColor="@color/recognition_fg"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
