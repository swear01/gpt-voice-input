<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/recognition_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:id="@+id/mic_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/cd_mic"
            android:src="@drawable/ic_mic"
            app:tint="@color/recognition_fg" />

        <ProgressBar
            android:id="@+id/processing_bar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/recognition_fg"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textColor="@color/recognition_fg"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/recognition_fg_dim"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/error_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/cancel_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textColor="@color/recognition_fg" />

            <Button
                android:id="@+id/retry_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retry"
                android:textColor="@color/recognition_fg" />
        </LinearLayout>

        <Button
            android:id="@+id/settings_action_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/open_settings"
            android:textColor="@color/recognition_fg"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/gear_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_settings"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        app:tint="@color/recognition_fg_dim" />

</FrameLayout>
