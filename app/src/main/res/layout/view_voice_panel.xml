<?xml version="1.0" encoding="utf-8"?>
<!--
    Voice-only IME panel, Google/Gboard voice-dictation style: a red ring
    around the mic that expands with the input level (invisible when silent),
    status/hint text centered below the mic, and a small gear in the top-right
    corner. The mic + ring live in a fixed-size container so they are always
    concentric; the text block sits below with fixed spacing (never overlaps
    the mic, never clips at the panel edge). Tapping anywhere submits (or
    retries); the IME auto-returns to the previous keyboard after committing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/voice_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/recognition_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <!-- android:tint (not app:tint) is deliberate: the IME input view is
         inflated by the system LayoutInflater (a Service, not an
         AppCompatActivity), which ignores AppCompat-only attributes.
         GptVoiceIme also applies the tint in code — belt and braces. -->
    <ImageButton
        android:id="@+id/gear_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_settings"
        android:padding="9dp"
        android:src="@drawable/ic_settings"
        android:tint="@color/recognition_fg_dim"
        tools:ignore="UseAppTint" />

    <!-- Centered cluster: mic+ring, then status/hint below (Google-style). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Fixed-size container keeps ring and mic perfectly concentric. -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:gravity="center">

                <View
                    android:id="@+id/voice_ring"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:alpha="0"
                    android:background="@drawable/voice_ring" />

                <ImageView
                    android:id="@+id/mic_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/cd_mic"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/recognition_fg"
                    tools:ignore="UseAppTint" />

                <ProgressBar
                    android:id="@+id/processing_bar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:indeterminateTint="@color/recognition_fg"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:maxWidth="300dp"
                android:textColor="@color/recognition_fg"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:maxWidth="300dp"
                android:textColor="@color/recognition_fg_dim"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
