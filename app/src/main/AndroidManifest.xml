<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GptVoiceInput">

        <!--
            The only user-facing entry point. Launched by SwiftKey (and other
            IMEs / apps) through the standard ACTION_RECOGNIZE_SPEECH intent.
            Deliberately NOT a MAIN/LAUNCHER activity: the app has no launcher
            entry and behaves like a small system component.
        -->
        <activity
            android:name=".ui.RecognitionActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GptVoiceInput.Recognition">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings are reachable only through the gear button in the
             recognition panel (Settings → Apps also works). -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />
    </application>

</manifest>
