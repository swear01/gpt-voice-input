<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GptVoiceInput">

        <!--
            The only user-facing entry point. Launched by SwiftKey (and other
            IMEs / apps) through the standard ACTION_RECOGNIZE_SPEECH intent.
            Deliberately NOT a MAIN/LAUNCHER activity: the app has no launcher
            entry and behaves like a small system component.
        -->
        <activity
            android:name=".ui.RecognitionActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.GptVoiceInput.Recognition">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Settings are reachable through the gear button in the recognition
            panel, and through the package front-door alias below (Android
            Settings → App info → Open on systems that expose that action).
        -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.GptVoiceInput.Settings" />

        <!--
            Package front door, NOT a launcher entry.

            ACTION_MAIN + CATEGORY_INFO is Android's mechanism for a package
            that needs an "Open" action (Settings / installer / package
            managers) without appearing in the app drawer:
            PackageManager.getLaunchIntentForPackage() queries CATEGORY_INFO
            before falling back to CATEGORY_LAUNCHER, and launchers only show
            CATEGORY_LAUNCHER activities.

            The alias keeps SettingsActivity itself non-exported; external
            access goes through this narrow front door only.
        -->
        <activity-alias
            android:name=".SettingsFrontDoor"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".ui.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
